# Copy to .env and fill locally. Never send a bot token in chat or commit it.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Haru language: ko (Korean) or ja (Japanese).
HARU_LANGUAGE=ko
# 8: quantized backbone, bf16 or none: original BF16 backbone.
HARU_QUANTIZE=8
# One conversation at a time; 0 disables expiry, otherwise 60-3600 seconds.
HARU_MAX_SESSION_SECONDS=0
# Absolute path to a permitted, clean single-speaker voice sample; if blank use the locally prepared default for HARU_LANGUAGE.
HARU_REFERENCE_PATH=
# Set HARU_VOICE_BACKEND=gemma-yuna for Korean STT, Gemma and Yuna.
# HARU_STREAM_LOCAL_DIR defaults to the bundled stream-local folder. Set an absolute path to override.
HARU_VOICE_BACKEND=haru
HARU_STREAM_LOCAL_DIR=
