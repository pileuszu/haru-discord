#!/bin/bash
# The native app starts this wrapper, so Finder launches use the pinned cache too.
set -euo pipefail
source "$(dirname "$0")/env.sh"
if [[ "${1:-}" == "-m" && "${2:-}" == "haru_mlx.native" ]]; then
    MODEL_PATH="$("$HARU_PROJECT_ROOT/.venv/bin/python" -c 'import sys; sys.path.insert(0, sys.argv[1]); from download_model import model_path; print(model_path())' "$HARU_PROJECT_ROOT/scripts")"
    HAS_MODEL=0; HAS_PRECISION=0
    for ARG in "$@"; do
        case "$ARG" in --model|--model=*|--hf-repo|--hf-repo=*) HAS_MODEL=1;; --quantize|--quantize=*) HAS_PRECISION=1;; esac
    done
    [[ "$HAS_MODEL" == 1 ]] || set -- "$@" --model "$MODEL_PATH"
    [[ "$HAS_PRECISION" == 1 ]] || set -- "$@" --quantize 8
    # This project starts the character and UI in Korean.
    set -- "$@" --language ko
fi
exec "$HARU_PROJECT_ROOT/.venv/bin/python" "$@"
