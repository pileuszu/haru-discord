# Copy to .env and fill locally. Never send a bot token in chat or commit it.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Optional: defaults to the application's owner. Only this user may control Haru.
DISCORD_ALLOWED_USER_ID=
# One conversation at a time; seconds, 60-3600.
HARU_MAX_SESSION_SECONDS=600
# Optional absolute path to a voice reference you have permission to use.
# If blank, the locally generated Korean demo voice is used.
HARU_REFERENCE_PATH=
